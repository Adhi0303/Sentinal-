{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^acc_[a-zA-Z0-9]{1,20}$"
    },
    "amount": { "type": "number", "minimum": 0.01, "maximum": 50.00 },
    "reason": { "type": "string" }
  },
  "required": ["account_id", "amount", "reason"]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "destination_account": { "type": "string", "pattern": "^[0-9]{8,12}$" },
    "routing_number": { "type": "string", "pattern": "^[0-9]{9}$" },
    "amount": { "type": "number", "minimum": 1.00, "maximum": 10000.00 }
  },
  "required": ["destination_account", "routing_number", "amount"]
}
